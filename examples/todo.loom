app TodoList
target: python 3.12

# Fast smoke test: pure in-memory logic, no database, no scheduler.

thing Task
  title: text
  priority: one of low, normal, high = normal
  status: one of open, done = open
  due: date?
  completed_at: datetime?

thing Summary
  open: number = 0
  done: number = 0
  overdue: number = 0

exact {
  def normalize_title(title: str) -> str:
      return " ".join(title.split()).casefold()
}

does complete task
  find the task in the list whose title matches the given title, compared with normalize_title
  set its status to done and completed_at to now
  return the updated task
  never complete a task that is already done
  always leave the other tasks in the list unchanged

example
  given tasks "buy milk" open and "pay rent" open, complete "BUY MILK"
  expect "buy milk" status done, completed_at set, "pay rent" status open

example
  given task "buy milk" with status done, complete "buy milk"
  expect a rule violation, "buy milk" still done

does summarize tasks
  count the open and done tasks ~ a single pass over the list is plenty
  a task is overdue when it is open and its due date is before today
  return a Summary
  always count each task exactly once as open or done

example
  given an open task due tomorrow, an open task due yesterday, a done task due yesterday
  expect open 2, done 1, overdue 1

example
  given no tasks
  expect open 0, done 0, overdue 0
